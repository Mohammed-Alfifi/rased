# Copy to deploy/.env and replace every value. Generate secrets with:  openssl rand -hex 32
RASED_DB_PASSWORD=change-me
RASED_JWT_SECRET=change-me-64-hex-chars
RASED_SERVICE_KEY=change-me-64-hex-chars
# First start only: creates the "admin" user. Remove it after the first login.
RASED_ADMIN_PASSWORD=change-me-at-least-10-chars
# Interface the command centre listens on (127.0.0.1 behind a TLS reverse proxy, or the control-room IP)
RASED_BIND=127.0.0.1
# Vision
RASED_TARGET_FPS=15
RASED_DEVICE=
# Path inside the vision container to a trained fight model, e.g. /app/extra-models/fight.onnx
RASED_FIGHT_MODEL=
RASED_MODELS_DIR=./models
# Exported models (training/export_models.py), mounted from RASED_MODELS_DIR:
# RASED_POSE_MODEL=/app/extra-models/yolo11n-pose.engine
# RASED_OBJECT_MODEL=/app/extra-models/yolo11n.engine
